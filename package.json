{
  "name": "distributed-wagering-processor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:e2e": "bun test test/e2e",
    "test:all": "bun test",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "diagram": "bun scripts/build-diagram.ts && bun scripts/build-sequence-diagram.ts",
    "demo:sqs": "bun scripts/send-wager-message.ts",
    "trace:sql": "bun scripts/trace-sql.ts",
    "stack:up": "docker compose up -d --build --wait",
    "stack:cluster": "docker compose --profile cluster up -d --build --wait",
    "infra:down": "docker compose --profile cluster down -v"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@nestjs/testing": "^12.2.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "decimal.js": "^10.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3"
  }
}
